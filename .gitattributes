# Normalize line endings to LF on checkout and commit
* text=auto

# Explicit line endings for code that must be LF
*.php text eol=lf
*.sh text eol=lf

# Exclude only runtime/generated artifacts from git archive /
# composer create-project tarballs. Framework files (.gitignore,
# tests/, .notes/, .agents/) and AI instruction configs (.github/
# copilot-instructions.md, .cursor/, .continue/, cline_docs/, etc.)
# ship with the skeleton — that is the product.
/var/ export-ignore
.phpunit.result.cache export-ignore
*.sqlite export-ignore
