# Normalize line endings to LF on checkout and commit
* text=auto

# Explicit line endings for code that must be LF
*.php text eol=lf
*.sh text eol=lf

# Exclude these from git archive / composer create-project tarballs
/.github/ export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.notes/ export-ignore
/.agents/ export-ignore
/cline_docs/ export-ignore
/.cursor/ export-ignore
/.continue/ export-ignore
/tests/ export-ignore
/var/ export-ignore
.phpunit.result.cache export-ignore
*.sqlite export-ignore
