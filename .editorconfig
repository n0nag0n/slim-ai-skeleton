root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_style = space
indent_size = 4

[*.{js,css,scss,less,json,yml,yaml,neon,neon.dist,xml,dist,md,twig,html,sh}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
end_of_line = lf
